{
  "name": "graphql-rust",
  "displayName": "GraphQL Rust",
  "description": "GraphQL Language Server and Codegen for Rust",
  "version": "0.1.0",
  "publisher": "emma",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:graphql",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "graphql.runCodegen",
        "title": "GraphQL: Run Codegen"
      },
      {
        "command": "graphql.clearCache",
        "title": "GraphQL: Clear Cache"
      }
    ],
    "configuration": {
      "title": "GraphQL Rust",
      "properties": {
        "graphql-rust.serverPath": {
          "type": "string",
          "description": "Path to graphql-rust binary. If empty, uses 'graphql-rust' from PATH.",
          "default": ""
        },
        "graphql-rust.logLevel": {
          "type": "string",
          "enum": ["error", "warn", "info", "debug", "trace"],
          "default": "info",
          "description": "Set the logging level for the LSP server."
        }
      }
    },
    "languages": [
      {
        "id": "graphql",
        "extensions": [
          ".graphql"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "install-local": "code --install-extension graphql-rust-*.vsix",
    "build:dev": "cargo build",
    "build:release": "cargo build --release"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^16.11.7",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^4.9.5"
  }
}
