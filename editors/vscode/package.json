{
  "name": "graphox",
  "displayName": "Graphox",
  "description": "Rust-powered GraphQL language server, validation, and codegen for VS Code",
  "version": "0.1.16",
  "publisher": "soundtrack",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/soundtrackyourbrand/graphox.git"
  },
  "homepage": "https://github.com/soundtrackyourbrand/graphox",
  "bugs": {
    "url": "https://github.com/soundtrackyourbrand/graphox/issues"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:graphql",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:yaml",
    "workspaceContains:**/graphox.yaml",
    "workspaceContains:**/graphox.yml"
  ],
  "extensionDependencies": [
    "redhat.vscode-yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "graphox.runCodegen",
        "title": "Graphox: Run Codegen"
      },
      {
        "command": "graphox.clearCache",
        "title": "Graphox: Clear Cache"
      },
      {
        "command": "graphox.restartServer",
        "title": "Graphox: Restart Server"
      }
    ],
    "configuration": {
      "title": "Graphox",
      "properties": {
        "graphox.serverPath": {
          "type": "string",
          "description": "Path to graphox binary. If empty, uses 'graphox' from PATH.",
          "default": ""
        },
        "graphox.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug",
            "trace"
          ],
          "default": "info",
          "description": "Set the logging level for the LSP server."
        }
      }
    },
    "languages": [
      {
        "id": "graphql",
        "extensions": [
          ".graphql"
        ]
      },
      {
        "id": "yaml",
        "filenames": [
          "graphox.yaml",
          "graphox.yml"
        ]
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "**/graphox.yaml",
        "url": "./out/graphox.schema.json"
      },
      {
        "fileMatch": "**/graphox.yml",
        "url": "./out/graphox.schema.json"
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": "graphox.yaml",
        "url": "./out/graphox.schema.json"
      },
      {
        "fileMatch": "graphox.yml",
        "url": "./out/graphox.schema.json"
      },
      {
        "fileMatch": "**/graphox.yaml",
        "url": "./out/graphox.schema.json"
      },
      {
        "fileMatch": "**/graphox.yml",
        "url": "./out/graphox.schema.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc --noEmit -p ./ && pnpm run bundle",
    "bundle": "node ./esbuild.js",
    "watch": "node ./esbuild.js --watch",
    "package": "vsce package --skip-license",
    "install-local": "code --install-extension graphox-*.vsix",
    "build:dev": "cargo build -p graphox",
    "build:release": "cargo build -p graphox --release"
  },
  "dependencies": {},
  "devDependencies": {
    "@vscode/vsce": "^3.2.1",
    "@types/minimatch": "^3.0.5",
    "@types/node": "^16.11.7",
    "@types/semver": "^7.3.10",
    "@types/vscode": "^1.75.0",
    "esbuild": "^0.25.0",
    "vscode-languageclient": "^8.1.0",
    "typescript": "^4.9.5"
  }
}
