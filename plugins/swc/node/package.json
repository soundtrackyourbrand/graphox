{
  "name": "@graphox/swc-plugin",
  "version": "0.4.4",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:wasm": "cargo build --manifest-path ../rust/Cargo.toml --target wasm32-wasip1 --release && mkdir -p wasm && cp ../../../target/wasm32-wasip1/release/graphox_swc_plugin.wasm wasm/",
    "build:all": "pnpm run build:wasm && pnpm run build",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "files": [
    "dist/",
    "wasm/",
    "README.md"
  ],
  "keywords": [
    "graphql",
    "swc",
    "plugin",
    "codegen",
    "codesplitting"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "jsonc-parser": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/soundtrackyourbrand/graphox",
    "directory": "plugins/swc/node"
  },
  "license": "UNLICENSED"
}
