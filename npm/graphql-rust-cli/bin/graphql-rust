#!/bin/sh

# This script is the entry point for the graphql-rust CLI
# It locates the actual binary and executes it with all arguments

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BINARY="$SCRIPT_DIR/graphql-rust"

# Check if binary exists
if [ ! -f "$BINARY" ]; then
    echo "Error: graphql-rust binary not found at $BINARY"
    echo "Please run 'npm install' to download the binary."
    exit 1
fi

# Execute the binary with all arguments
exec "$BINARY" "$@"
